NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Sentry. "local" disables reporting however the app is built, and a blank DSN
# is a safe no-op too. The deploy workflows set "development" (sampled) and
# "production" (full rate). See client/AGENTS.md, "What reaches Sentry".
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=local

# Android Code Signing (For Local Builds)
TAURI_ANDROID_KEYSTORE_PATH="/absolute/path/to/dumosrx-release-key.jks"
TAURI_ANDROID_KEYSTORE_PASSWORD="your-keystore-password"
TAURI_ANDROID_KEY_ALIAS="dumosrx-alias"
TAURI_ANDROID_KEY_PASSWORD="your-keystore-password"